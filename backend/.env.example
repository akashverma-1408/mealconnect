# Copy to backend/.env and fill in real values: cp backend/.env.example backend/.env
DATABASE_URL=postgresql+psycopg://mealconnect:CHANGE_ME@localhost:5432/mealconnect
TEST_DATABASE_URL=postgresql+psycopg://mealconnect:CHANGE_ME@localhost:5432/mealconnect_test
REDIS_URL=redis://localhost:6379/0
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME
# Signs/verifies payment webhooks. Generate like JWT_SECRET_KEY.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME

# --- Optional tuning (defaults shown) ---
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=120
# MENU_CACHE_TTL_SECONDS=300
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=300/minute
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=10/hour
# TRUSTED_PROXY_COUNT=0          # set to 1 behind Nginx, 2 behind ALB + Nginx

# --- Payments: "mock" (default sandbox) or "razorpay" (test mode) ---
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=CHANGE_ME
# (PAYMENT_WEBHOOK_SECRET above must equal the webhook secret set in the Razorpay dashboard)

# --- Hosted / free-tier deployment (see docs/deployment.md) ---
# DATABASE_URL may be a plain postgresql://... URL from Neon; the driver is added automatically.
# REDIS_URL=rediss://default:CHANGE_ME@your-db.upstash.io:6379
# CORS_ORIGINS=https://your-app.vercel.app        # comma-separated list of allowed frontends
# EMBEDDED_WORKER=true       # run the job worker inside the API (no separate worker service)
# WORKER_POLL_SECONDS=20     # 1-25; higher = fewer Redis commands
# DB_POOL_SIZE=3             # keep small for free databases
# DB_MAX_OVERFLOW=2
# REDIS_SOCKET_TIMEOUT=2     # seconds; raise for a Redis in another region
